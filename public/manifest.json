{
  "manifest_version": 3,
  "name": "DeepSeek UI Engine",
  "version": "0.2.0",
  "description": "为 DeepSeek 官方聊天添加安全的指标、图表、表格与时间轴。",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "action": {
    "default_title": "DeepSeek UI Engine",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://chat.deepseek.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "world": "ISOLATED"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
